APP_NAME="Jukung Bulik"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-lu.com
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# === DATABASE SETUP ===
# Ganti dengan kredensial database VPS lu
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jukungbulik_db
DB_USERNAME=jukung_user
DB_PASSWORD=password_rahasia_lu

# === SESSION & QUEUE ===
# Queue Wajib database biar email & WA jalan di background
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# === EMAIL SETUP (RESEND) ===
# Kalau pake Resend, masukin API key-nya sebagai password. Host dan port tetep begini.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_123456789_masukin_api_key_resend_lu_disini
MAIL_ENCRYPTION=smtps
MAIL_FROM_ADDRESS="tiket@domain-lu.com"
MAIL_FROM_NAME="Tiket Jukung Bulik"

# === WHATSAPP API (FONNTE) ===
FONNTE_TOKEN=masukin_token_fonnte_lu_disini

# === PAYMENT GATEWAY (XENDIT) ===
XENDIT_SECRET_KEY=xnd_production_masukin_secret_key_lu
XENDIT_WEBHOOK_TOKEN=masukin_webhook_token_lu

# === FILAMENT & SESSION SECURITY ===
FILAMENT_ADMIN_EMAIL=admin@domain-lu.com
FILAMENT_ADMIN_PASSWORD=GantiDenganPasswordKuatMinimal12Karakter!
FILAMENT_AUTH_GUARD=web
FILAMENT_PATH=admin
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SESSION_ENCRYPT=true

